## Cell ids for random points, with their derived quantities.
##
## Generated by `tools/generate_corpus.py` from s2sphere. Do not edit by hand.
##
## Internal to this package.
CellIdCorpus := [].{

	## One point and everything upstream reports about the leaf cell containing
	## it. Latitudes and longitudes are in degrees; `parents` holds the ancestor
	## ids at levels 0, 5, 10, 15, 20 and 25.
	Case := {
		lat : F64,
		lng : F64,
		id : U64,
		token : Str,
		face : U64,
		i : U64,
		j : U64,
		orientation : U64,
		center_lat : F64,
		center_lng : F64,
		parents : List(U64),
		prev_id : U64,
		next_id : U64,
		edge_neighbors : List(U64),
		vertex_neighbors : List(U64),
		all_neighbors : List(U64),
	}

	## The levels `parents` holds, in order.
	parent_levels : List(U64)
	parent_levels = [0, 5, 10, 15, 20, 25]

	## The level `vertex_neighbors` was taken at.
	vertex_neighbor_level : U64
	vertex_neighbor_level = 26

	## The level `all_neighbors` was taken at, of the level-10 ancestor.
	all_neighbor_level : U64
	all_neighbor_level = 10

